# Copy to .env.local for local development. Public values only: these two are
# safe in the browser. Never put the service role key or the Salla secret in a
# NEXT_PUBLIC_ variable or in any committed file.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The site's public address, used in sign-in links (no trailing slash).
# Add <site>/ar/auth/callback and <site>/en/auth/callback to Supabase Auth
# redirect URLs.
NEXT_PUBLIC_SITE_URL=https://qari-bnmaasd3-3308.vercel.app

# Server only, never NEXT_PUBLIC_: set it in the hosting settings (e.g. Vercel
# environment variables), not in a committed file. Only the Salla webhook
# needs it.
# SUPABASE_SERVICE_ROLE_KEY=

# Salla (server only). The webhook secret from Salla: Settings, Webhooks.
# SALLA_WEBHOOK_SECRET=
# Optional: order statuses that unlock the book (comma separated).
# Default: in_progress,completed,delivering,delivered,shipped
# SALLA_GRANT_STATUSES=

# Email through Resend (server only, never NEXT_PUBLIC_). Without both, the app
# sends no email and says so in the owner panel. See "البريد · Email" in README.
# RESEND_API_KEY=re_...
# MAIL_FROM=سَجيّة <hello@your-domain.com>
